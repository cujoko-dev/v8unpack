1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@V8UNPACK_WINDOWS_VERSION_TWEAK@
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@V8UNPACK_WINDOWS_VERSION_TWEAK@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904E3"
    BEGIN
      VALUE "CompanyName", "V8Unpack developers community"
      VALUE "FileDescription", "V8 Unpack Tool - Built by Cujoko"
      VALUE "FileVersion", "@PROJECT_VERSION@ (Built by Cujoko)"
      VALUE "InternalName", "v8unpack"
      VALUE "LegalCopyright", "Denis Demidov, Sergey Batanov, Sergey Rudakov and others"
      VALUE "OriginalFilename", "v8unpack.exe"
      VALUE "ProductName", "v8unpack - Built by Cujoko"
      VALUE "ProductVersion", "@PROJECT_VERSION@ (Built by Cujoko)"
      VALUE "Comments", "https://github.com/Cujoko/v8unpack"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1251
  END
END
